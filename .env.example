# ============================================================
#  BONVI HR — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ============================================================

# PORT YO'LAGI: 7xxx — bu loyihaga ajratilgan.
# Boshqa loyihalar bilan to'qnashmasligi tekshirilgan (2026-08-22).
# O'zgartirsangiz, avval "lsof -nP -iTCP:<port> -sTCP:LISTEN" bilan tekshiring.

# --- PostgreSQL ---
POSTGRES_USER=bonvi
POSTGRES_PASSWORD=bonvi_dev_parol_ozgartiring
POSTGRES_DB=bonvi_hr
POSTGRES_PORT=7432

# --- Redis ---
REDIS_PORT=7379

# --- API ---
API_PORT=7080
ASPNETCORE_ENVIRONMENT=Development

# --- Web ---
WEB_PORT=7173

# --- JWT (production'da ALBATTA o'zgartiring, min 32 belgi) ---
JWT__ISSUER=bonvi-hr
JWT__AUDIENCE=bonvi-hr-web
JWT__SIGNINGKEY=dev_uchun_kamida_32_belgili_maxfiy_kalit_almashtiring
JWT__ACCESSTOKENMINUTES=15
JWT__REFRESHTOKENDAYS=7

# --- Fayl saqlash ---
STORAGE__ROOTPATH=/data/uploads

# --- Birinchi administrator ---
# Faqat bazada bironta ham foydalanuvchi bo'lmaganda yaratiladi.
# Parolni ALBATTA o'zgartiring va production'da bu qatorlarni o'chiring.
BOOTSTRAP__ADMINLOGIN=905088888
BOOTSTRAP__ADMINPASSWORD=Bonvi_2026_ozgartiring
BOOTSTRAP__ADMINFULLNAME="Bosh administrator"
# Har bir rol uchun sinov hisobi (faqat development)
BOOTSTRAP__CREATEDEVUSERS=true

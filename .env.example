# ============================================================
#  BONVI HR — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ============================================================

# PORT YO'LAGI: 7xxx — bu loyihaga ajratilgan.
# Boshqa loyihalar bilan to'qnashmasligi tekshirilgan (2026-08-22).
# O'zgartirsangiz, avval "lsof -nP -iTCP:<port> -sTCP:LISTEN" bilan tekshiring.

# --- PostgreSQL ---
POSTGRES_USER=bonvi
POSTGRES_PASSWORD=bonvi_dev_parol_ozgartiring
POSTGRES_DB=bonvi_hr
POSTGRES_PORT=7432

# --- Redis ---
REDIS_PORT=7379

# --- API ---
API_PORT=7080
ASPNETCORE_ENVIRONMENT=Development

# --- Web ---
WEB_PORT=7173

# --- JWT (production'da ALBATTA o'zgartiring, min 32 belgi) ---
JWT__ISSUER=bonvi-hr
JWT__AUDIENCE=bonvi-hr-web
JWT__SIGNINGKEY=dev_uchun_kamida_32_belgili_maxfiy_kalit_almashtiring
JWT__ACCESSTOKENMINUTES=15
JWT__REFRESHTOKENDAYS=7

# --- Bazadagi sirlarni shifrlash ---
# Telegram tokeni endi ekrandan qo'yiladi va BAZADA saqlanadi (pastga
# qarang). U shifrlangan holda yotadi — himoya serverga kirgan odamdan
# emas, ZAXIRA NUSXADAN: nusxa har kecha olinadi, fayl bo'lib ko'chiriladi
# va boshqa mashinaga tushishi mumkin.
#
# BO'SH qoldirsangiz kalit JWT__SIGNINGKEY dan chiqariladi va hamma narsa
# ishlayveradi — shu sababli bu qator majburiy emas.
#
# ⚠️ Kalit almashsa, saqlangan sirlar OCHILMAY qoladi. Bu yo'qotish emas:
# ekranda sozlama «kiritilmagan» bo'lib ko'rinadi va token qayta
# kiritiladi. Lekin JWT kalitini tez-tez almashtirsangiz, bu yerga
# ALOHIDA kalit bergan ma'qul — u holda ikkalasi bir-biriga bog'liq
# bo'lmaydi.
#
#   openssl rand -base64 32
SETTINGS__SECRETKEY=

# --- Fayl saqlash ---
STORAGE__ROOTPATH=/data/uploads

# --- Zaxira nusxalash (faqat production, docker-compose.prod.yml) ---
# Necha kunlik zaxira saqlanadi — eskilari avtomatik o'chadi.
BACKUP_RETENTION_DAYS=30
# crond jadvali, konteyner soati (UTC) bo'yicha. Standart: 22:00 UTC =
# 03:00 Toshkent vaqti (UTC+5, yozgi vaqtga o'tish yo'q). Qiymat bo'sh
# joy va `*` belgisi bor, shu sababli tirnoqda bo'lishi SHART.
BACKUP_CRON_SCHEDULE="0 22 * * *"

# --- Xato jurnali (fayl) ---
# `docker logs api` konteyner qayta ishga tushishi bilan tozalanadi. Nosozlik
# esa odatda KEYIN aniqlanadi, shu sababli xatolar faylga ham yoziladi.
# Faylga faqat texnik ma'lumot tushadi (yo'l, holat kodi, foydalanuvchi Guid'i,
# IP, tozalangan istisno matni) — F.I.Sh., telefon, JSHSHIR va SQL parametrlari
# ATAYLAB yozilmaydi. Sentry ishlatilmaydi: u ma'lumotni tashqariga chiqaradi.
#
# Jurnal papkasi (xostdagi yo'l). Git'dan tashqarida — .gitignore ga qarang.
# ⚠️ PRODUCTION'da birinchi ishga tushirishdan oldin:
#       mkdir -p ./logs && chown 2000:2000 ./logs
#    (API konteyner ichida `uid 2000` ostida ishlaydi va root papkaga yoza olmaydi)
LOG_DIR=./logs
# Qaysi darajadan boshlab faylga yoziladi: Warning | Error | Fatal.
# Information ATAYLAB tavsiya etilmaydi — u har bir so'rovni faylga tushiradi.
LOG_MIN_LEVEL=Warning
# Necha kunlik jurnal saqlanadi — eskilari avtomatik o'chadi.
# Bu maxfiylik chegarasi: xato tafsiloti abadiy yotmasligi kerak
# (zaxira nusxadagi BACKUP_RETENTION_DAYS bilan bir xil fikr).
LOG_RETENTION_DAYS=30
# Disk chegarasi. Eng yomon holatda jurnal egallaydigan joy =
# LOG_MAX_FILE_MB × LOG_MAX_FILE_COUNT (standart: 10 × 50 = 500 MB).
# Faqat kunlik chegara yetarli emas: takrorlanuvchi xato bir kunning
# o'zida diskni to'ldirib, butun serverni to'xtatib qo'yishi mumkin.
LOG_MAX_FILE_MB=10
LOG_MAX_FILE_COUNT=50

# --- Birinchi administrator ---
# Faqat bazada bironta ham foydalanuvchi bo'lmaganda yaratiladi.
# Parolni ALBATTA o'zgartiring.
#
# Bu ikki qator development'da ham, production'da ham KERAK: parol
# berilmasa administrator umuman yaratilmaydi (standart parol qo'yish
# ataylab rad etilgan) va yangi bazaga kira oladigan hech kim qolmaydi.
# Birinchi kirishdan keyin parolni tizim ichida almashtirish tavsiya etiladi.
BOOTSTRAP__ADMINLOGIN=905088888
BOOTSTRAP__ADMINPASSWORD=Bonvi_2026_ozgartiring
BOOTSTRAP__ADMINFULLNAME="Bosh administrator"
# Har bir rol uchun sinov hisobi (faqat development)
BOOTSTRAP__CREATEDEVUSERS=true

# ============================================================
#  TELEGRAM ANKETA BOTI
#
#  Bot ochiq vakansiyalarga ariza qabul qiladi va nomzodni
#  voronkaga qo'shadi.
#
#  Bot hisobi (login va parol) to'ldirilmasa bot umuman ishga
#  tushmaydi. Token esa endi majburiy emas — uni ekrandan qo'ysa
#  ham bo'ladi. Tizimning qolgan qismi ikkala holatda ham oddiy
#  ishlaydi.
# ============================================================

# 1) @BotFather dan olingan token — ZAXIRA qiymat.
#    Telegram'da @BotFather ga yozing: /newbot → nom → username.
#
#    ⭐ TOKENNING ASOSIY JOYI ENDI SHU FAYL EMAS. U tizim ichida,
#    «Tizim sozlamalari» ekranida turadi (yon menyu → TIZIM →
#    Tizim sozlamalari) va uni faqat super administrator ko'ra oladi.
#    Sabab oddiy: token almashadi (bot qayta yaratiladi, tokeni
#    o'g'irlangan deb bekor qilinadi, sinov botidan ishchi botga
#    o'tiladi) va har safar serverga kirib, faylni tahrirlab,
#    konteynerni qayta ishga tushirish kerak edi.
#
#    Bu qator BO'SH qolishi mumkin. Bot avval ekrandagi qiymatni
#    so'raydi va faqat u yo'q bo'lsa shu yerga tushadi. Ya'ni:
#      • mavjud o'rnatmalar hech narsa o'zgartirmasdan ishlayveradi;
#      • yangi o'rnatishda botni ekranga kirmasdan yoqib qo'ysa ham
#        bo'ladi, keyin ekrandan o'zgartiriladi.
#
#    Ekranda token qo'yilsa, bot uni bir daqiqa ichida o'zi oladi —
#    qayta ishga tushirish SHART EMAS.
TELEGRAM__BOTTOKEN=

# 2) Bot uchun XIZMAT hisobi — odam emas.
#
#    ⚠️ BU IKKISI TIZIM SOZLAMALARIGA HECH QACHON KO'CHIRILMAYDI.
#    Bot aynan shu login va parol bilan tizimga kirib, yuqoridagi
#    tokenni oladi — ularni bazaga qo'yish «kalitni qulflangan
#    xonaning ichida qoldirish» bo'lardi.
#    Login telefon raqami bo'lishi shart (tizimda identifikator shu).
#    Kompaniyaning ISHLATILMAYOTGAN raqamini bering.
#
#    Hisob eng kam huquqli «recruiting_bot» roli bilan yaratiladi:
#    faqat ochiq vakansiyalarni o'qiy oladi va nomzod yoza oladi.
#    Xodimlarga, okladga va belgilarga umuman yeta olmaydi.
BOOTSTRAP__BOTLOGIN=
BOOTSTRAP__BOTPASSWORD=
BOOTSTRAP__BOTFULLNAME="Telegram bot"

# Long polling so'rovi necha soniya ochiq tursin (1-60).
TELEGRAM__POLLTIMEOUT=30
# Yarim qolgan ariza qancha vaqtdan keyin unutilsin (daqiqa).
TELEGRAM__CONVERSATIONTIMEOUT=1440

# Kutilayotgan migratsiyalarni ishga tushishda avtomatik qo'llash.
# Development'da bu bayroqsiz ham yoqiq (muhit bo'yicha), shu sababli
# qiymat faqat docker-compose.prod.yml uchun ahamiyatli. U yerda standart
# qiymat `true` — sababi o'sha faylda batafsil yozilgan. Bazani alohida
# jamoa boshqarsa yoki migratsiya xavfli bo'lsa, bu yerda `false` qo'ying
# va migratsiyani qo'lda qo'llang.
BOOTSTRAP__AUTOMIGRATE=true

# ════════════════════════════════════════════════════════════
#  PRODUCTION MANZILI  (faqat docker-compose.prod.yml uchun)
# ════════════════════════════════════════════════════════════

# Caddy qaysi manzilda tinglaydi — HTTPS shu qiymatga bog'liq.
#
#   hr.bonvi.uz       → Caddy Let's Encrypt sertifikatini O'ZI oladi
#                       va HTTP→HTTPS yo'naltirishni o'zi qo'yadi
#   :80               → domensiz, faqat HTTP (sinov uchun)
#
# ⚠️ BERILMASA `:80` bo'ladi, ya'ni HTTPS UMUMAN OLINMAYDI. Bazada
#    haqiqiy odamlarning JSHSHIR, pasporti va oyligi bor — ochiq HTTP
#    orqali ularni tarmoqdagi har kim o'qiy oladi. Domenni olgan
#    kuningizoq shu yerga yozing.
#
# Domen serverning IP manziliga A-yozuv bilan yo'naltirilgan bo'lishi
# va 80/443 portlar tashqaridan ochiq bo'lishi shart — Let's Encrypt
# sertifikatni aynan shu ikkalasi orqali tekshiradi.
SITE_ADDRESS=:80

# Eski manzilni yangi domenga yo'naltirish — VAQTINCHALIK.
#
# Bo'sh qoldiring. To'ldirilsa (masalan `http://189.74.98.57`), Caddy
# o'sha manzilga kelgan so'rovni domenga 302 bilan uzatadi. Kerak
# bo'ladigan yagona holat: tizim allaqachon IP orqali ishlatilgan va
# domenga ko'chirilmoqda — usiz IP so'rovlari sertifikat xatosiga
# uriladi va foydalanuvchi «server ishlamayapti» deb o'ylaydi.
#
# Hamma foydalanuvchi domenga ko'chgach BO'SHATILADI.
LEGACY_ADDRESS=

# CORS — faqat frontend BOSHQA domendan berilsa to'ldiring.
#
# Odatiy o'rnatishda BO'SH qoldiring: web va API bir xil domenda
# (Caddy `/api/*` ni proksi qiladi), ya'ni brauzer uchun bu
# same-origin va CORS umuman ishlamaydi.
#
# To'ldirilsa TO'LIQ origin bo'lishi shart — sxema bilan, oxirida
# «/» siz: https://hr.bonvi.uz
CORS_ORIGIN=

# ⚠️ Zaxira sozlamalari (BACKUP_CRON_SCHEDULE, BACKUP_RETENTION_DAYS) shu
#    faylning YUQORI qismida, «Zaxira» bo'limida turadi. Ilgari ular bu
#    yerda IKKINCHI marta ham yozilgan edi va nusxadagi jadval TIRNOQSIZ
#    edi. Docker Compose bunday faylni o'zi o'qiydi va sezmaydi, lekin
#    `./bonvi` uni shell orqali yuklaydi — u yerda `0 22 * * *` ikkiga
#    bo'linib, «22: command not found» bilan yiqilardi. Ya'ni serverda
#    `./bonvi backup` ishlamay qolgandi. Takror kalit qo'shmang.

# ══════════════════════════════════════════════════════════════
#  QURILMA AGENTI (yuz terminali) — ixtiyoriy
#
#  Agent SUKUT BO'YICHA ishga tushmaydi. Yoqish:
#      COMPOSE_PROFILES=agent ./bonvi up
#
#  ⚠️ Agent terminal bilan BIR TARMOQDA bo'lishi shart: ishlab
#  chiqarish serveri (VPS) ofis tarmog'iga kira olmaydi. Ishlab
#  chiqarishda bu konteyner ofisdagi mashinada ishlaydi va
#  Agent__ApiBaseUrl sifatida https://hr.bonvi.uz beriladi.
#
#  ⚠️ Agent terminalning SOZLAMASIGA tegmaydi: u hodisalarni
#  o'qiydi va odamlarni yozadi, xolos. Verifix bilan parallel
#  ishlashi aynan shunga tayanadi.
# ══════════════════════════════════════════════════════════════

# Qurilma kartasida BIR MARTA ko'rsatilgan qabul tokeni
AGENT__DEVICETOKEN=

# Terminalning tarmoqdagi manzili — 192.168.1.50 yoki 192.168.1.50:8000
AGENT__DEVICEHOST=

# Terminal administratori
AGENT__DEVICEUSER=admin
AGENT__DEVICEPASSWORD=

# Halqalarning oralig'i (soniya) — odatda o'zgartirilmaydi.
# Hodisalar 2 soniyada: jonli kadr o'tgan odamni hali terminal oldida ushlashi uchun.
AGENT__EVENTSINTERVAL=2
AGENT__ROSTERINTERVAL=60

# Jonli kadr kanali (MinMoe'da 101). Bo'sh qoldirilsa o'tishlar suratsiz keladi.
# ⚠️ Qurilmaning saveCapPic/uploadCapPic sozlamasi ATAYLAB ishlatilmaydi —
# u butun qurilmaga tegishli va Verifix'ga boradigan hodisalarni ham o'zgartirardi.
AGENT__SNAPSHOTCHANNEL=101

# ══════════════════════════════════════════════════════════════
#  XODIM ILOVASI (/ilova/) — faqat production (docker-compose.prod.yml)
#
#  Sukut bo'yicha YOPIQ: /api/employee-auth va /api/me marshrutlari umuman
#  ro'yxatga olinmaydi (404). HR «Ilova» bo'limi baribir ishlaydi. Ilova
#  xodimlarga berilgach — egasining qarori bilan — true qiling va API ni
#  qayta ko'taring. Dev stack'da (docker-compose.yml) ilova doim ochiq.
# ══════════════════════════════════════════════════════════════
EMPLOYEE_APP_ENABLED=false

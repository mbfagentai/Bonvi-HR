<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ═══════════════════════════════════════════════════════════
     INFRASTRUCTURE QATLAMI — texnologiya adapterlari
     Domain/Application'da e'lon qilingan INTERFEYSLARNI
     amalga oshiradi: PostgreSQL, Redis, fayl tizimi, Telegram.
     QOIDA: bu qatlamni almashtirish biznes mantiqqa tegmaydi.
    ═══════════════════════════════════════════════════════════
  -->

  <PropertyGroup>
    <RootNamespace>Bonvi.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bonvi.Application\Bonvi.Application.csproj" />
  </ItemGroup>

  <!--
    Ma'lumotnomalarning boshlang'ich qiymatlari yig'malaning ICHIGA joylanadi.
    Nega: ular kod bilan bir xil versiyaga ega bo'lishi kerak. Alohida fayl
    bo'lsa, Docker tasviriga nusxalash unutilishi va urug'lantirish
    ishlab chiqarishda jimgina o'tkazib yuborilishi mumkin edi.
    Fayllar hali yo'q bo'lsa — shablon xatosiz bajariladi (Include bo'sh qoladi).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Seed/data/*.json" />
  </ItemGroup>

  <!--
    Planshet anketasi PDF'i uchun shriftlar va logotip — yig'malaning ICHIDA
    (urug' ma'lumotlari bilan bir xil sabab: Docker tasviriga nusxalash
    unutilmasin). Konteynerda tizim shriftlari YO'Q (SkiaSharp
    `NoDependencies` tanlangan), ya'ni shriftsiz PDF umuman chizilmasdi.
    Litsenziyalar fayllar yonida (Reports/Pdf/Fonts/*.txt).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Reports/Pdf/Fonts/*.ttf" />
    <EmbeddedResource Include="Reports/Pdf/Assets/*.png" />
  </ItemGroup>

  <!--
    Blankalar shablonlari (docs/SPEC-blankalar.md §4.10) — urug' ma'lumotlari bilan bir xil
    sabab: ta'rif kod bilan bir versiyada yuradi. Fayllar hali yo'q bo'lsa Include bo'sh qoladi.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Blanks/Templates/*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="ClosedXML" />

    <!-- Onlayn anketaning bot tekshiruvi (Cloudflare Turnstile) — nomli HttpClient, 5 s muddat -->
    <PackageReference Include="Microsoft.Extensions.Http" />

    <!-- Planshet anketasi PDF'i (sabab va litsenziya: Directory.Packages.props) -->
    <PackageReference Include="PDFsharp-MigraDoc" />

    <!-- Xodim rasmini kvadrat qilib kichraytirish (sabab: Directory.Packages.props) -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

</Project>

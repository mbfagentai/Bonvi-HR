{
  "schema": 1,
  "code": "HR-F06",
  "version": "1.0",
  "title": "Moslashtirish rejasi (1–30–60–90 kun) va ustoz biriktirish",
  "subject": "employee",
  "legalStatus": "final",
  "retention": "Nusxalar: xodim, ustoz, bo'lim rahbari, shaxsiy ish",
  "sections": [
    {
      "id": "hdr",
      "title": "Xodim",
      "fields": [
        { "id": "employee", "type": "ref", "refKind": "employee", "label": "Xodim F.I.Sh.", "prefill": "subject.fullName", "readOnly": true },
        { "id": "position", "type": "text", "label": "Lavozim / bo'lim", "prefill": "subject.positionName" },
        { "id": "hireDate", "type": "date", "label": "Ishga chiqqan sana", "required": true, "prefill": "subject.hireDate" },
        { "id": "probationEnd", "type": "date", "label": "Sinov muddati tugash sanasi (+90 kun)", "prefill": "subject.probationEndDate" },
        { "id": "manager", "type": "ref", "refKind": "employee", "label": "Bevosita rahbar", "prefill": "subject.departmentHeadId" },
        { "id": "mentor", "type": "ref", "refKind": "employee", "label": "Ustoz-murabbiy (F.I.Sh., lavozim)", "required": true }
      ]
    },
    {
      "id": "s1",
      "title": "Ustoz-murabbiy majburiyatlari",
      "fields": [
        { "id": "duties", "type": "static", "text": "Ustoz — shu lavozimda kamida 1 yil ishlagan, intizomiy jazosi yo'q xodim. Ustoz: birinchi 30 kun har kuni yangi xodim bilan kamida 15 daqiqa ishlaydi; lavozim pasportidagi har jarayonni ko'rsatadi; 7, 30, 60-kun nazorat nuqtalarida baho beradi. Ustozlik uchun rag'batlantirish — HR-R07 bo'yicha (xodim sinovdan o'tsa)." }
      ]
    },
    {
      "id": "d1",
      "title": "1-kun",
      "fill": { "at": "step", "step": "day1" },
      "fields": [
        { "id": "day1Plan", "type": "static", "text": "Nima bo'lishi kerak: Shartnoma, buyruq, lavozim pasporti bilan tanishuv (HR-F11), mehnat muhofazasi yo'riqnomasi, ish joyi va asbob-uskuna, ustoz bilan tanishuv, ish rejimi va tabel qoidalari tushuntirildi. Kim tekshiradi: HR-4" },
        { "id": "day1Done", "type": "check", "label": "bajarildi", "required": true }
      ]
    },
    {
      "id": "d7",
      "title": "7-kun testi",
      "fill": { "at": "step", "step": "day7" },
      "fields": [
        { "id": "day7Plan", "type": "static", "text": "Nima bo'lishi kerak: 7-kun testi — lavozim pasporti bilimi (Google Forms), o'tish ≥ 70%. Kim tekshiradi: HR-4" },
        { "id": "day7Percent", "type": "percent", "label": "Natija (%)", "passAt": 70, "required": true },
        { "id": "day7Pass", "type": "computed", "label": "O'tdi (≥ 70%)", "hint": "o'tmasa — qayta (14-kun)", "valueType": "bool",
          "expr": { "op": "gte", "args": [ { "ref": "day7Percent" }, { "const": 70 } ] } }
      ]
    },
    {
      "id": "d30",
      "title": "30-kun",
      "fill": { "at": "step", "step": "day30" },
      "fields": [
        { "id": "day30Plan", "type": "static", "text": "Nima bo'lishi kerak: 30-kun suhbati: rahbar + ustoz + xodim. Baho: ish sifati, intizom, jamoa. Qaror: davom / qo'shimcha o'qitish / sinovni to'xtatish. Kim tekshiradi: Bo'lim rahbari" },
        { "id": "day30Decision", "type": "choice", "label": "Qaror", "required": true, "options": [
          { "value": "continue", "label": "davom" },
          { "value": "training", "label": "o'qitish" },
          { "value": "stop", "label": "to'xtatish", "extra": { "type": "longtext", "label": "Sabab", "required": true } }
        ] }
      ]
    },
    {
      "id": "d60",
      "title": "60-kun",
      "fill": { "at": "step", "step": "day60" },
      "fields": [
        { "id": "day60Plan", "type": "static", "text": "Nima bo'lishi kerak: 60-kun suhbati: rahbar bahosi (1–5), xodimning o'z savollari. Kim tekshiradi: Bo'lim rahbari" },
        { "id": "day60Score", "type": "score", "label": "Rahbar bahosi (1–5)", "required": true }
      ]
    },
    {
      "id": "d85",
      "title": "85-kun testi",
      "fill": { "at": "step", "step": "day85" },
      "fields": [
        { "id": "day85Plan", "type": "static", "text": "Nima bo'lishi kerak: 85-kun testi (amaliy + nazariy, ≥ 70%) va rahbarning yakuniy bahosi (HR-F07). Kim tekshiradi: HR-4, bo'lim rahbari" },
        { "id": "day85Percent", "type": "percent", "label": "Natija (%)", "passAt": 70, "required": true },
        { "id": "day85Pass", "type": "computed", "label": "O'tdi (≥ 70%)", "valueType": "bool",
          "expr": { "op": "gte", "args": [ { "ref": "day85Percent" }, { "const": 70 } ] } }
      ]
    },
    {
      "id": "notes",
      "title": "Reja va nazorat nuqtalari",
      "hint": "Ustoz kuzatuvlari (natija / baho)",
      "fill": { "at": "open" },
      "fields": [
        { "id": "notes1to7", "type": "longtext", "label": "1–7 (Ustoz)", "hint": "Lavozim pasportining 1–2 bo'limlari (vazifalar, jarayonlar) ustoz bilan o'qildi; asosiy 3 ta ish ustoz nazoratida bajarildi" },
        { "id": "notes8to30", "type": "longtext", "label": "8–30 (Ustoz)", "hint": "Barcha kundalik jarayonlar mustaqil, ustoz kuzatuvida; xatolar ro'yxati yuritiladi" },
        { "id": "notes31to60", "type": "longtext", "label": "31–60 (Ustoz kuzatadi)", "hint": "Mustaqil ish; haftalik/oylik jarayonlar (kalendar) birinchi marta bajariladi" }
      ]
    },
    {
      "id": "s3",
      "title": "Xodimning birinchi 30 kundagi savollari va javoblar (ustoz yozadi)",
      "fill": { "at": "open" },
      "fields": [
        { "id": "questions", "type": "table", "label": "Xodimning birinchi 30 kundagi savollari va javoblar", "minRows": 0, "maxRows": 50, "columns": [
          { "id": "date", "type": "date", "label": "Sana", "pdfWidth": 1 },
          { "id": "question", "type": "longtext", "label": "Savol / muammo", "pdfWidth": 3 },
          { "id": "answer", "type": "longtext", "label": "Javob / yechim", "pdfWidth": 3 }
        ] }
      ]
    }
  ],
  "steps": [
    { "id": "signEmployee", "title": "Xodim", "order": 1, "actor": "subjectEmployee", "mode": "either" },
    { "id": "signMentor", "title": "Ustoz", "order": 1, "actor": "field:mentor", "mode": "either" },
    { "id": "signHead", "title": "Bo'lim rahbari", "order": 1, "actor": "departmentHead", "mode": "either" },
    { "id": "signHr4", "title": "HR-4", "order": 1, "actor": "hr4", "mode": "electronic" },
    { "id": "day1", "title": "1-kun", "order": 2, "actor": "hr4", "mode": "electronic", "due": { "field": "hireDate", "days": 1 } },
    { "id": "day7", "title": "7-kun testi", "order": 2, "actor": "hr4", "mode": "electronic", "due": { "field": "hireDate", "days": 7 } },
    { "id": "day30", "title": "30-kun qarori", "order": 3, "actor": "departmentHead", "mode": "either", "due": { "field": "hireDate", "days": 30 } },
    { "id": "day60", "title": "60-kun: rahbar bahosi", "order": 4, "actor": "departmentHead", "mode": "either", "due": { "field": "hireDate", "days": 60 } },
    { "id": "day85", "title": "85-kun testi", "order": 5, "actor": "hr4", "mode": "electronic", "due": { "field": "hireDate", "days": 85 } },
    { "id": "day90", "title": "90-kun: HR-1 qarori", "order": 6, "actor": "hr1", "mode": "electronic",
      "decision": { "required": true, "options": [
        { "value": "passed", "label": "sinovdan o'tdi" },
        { "value": "failed", "label": "o'tmadi" }
      ] },
      "due": { "field": "hireDate", "days": 90 } }
  ]
}

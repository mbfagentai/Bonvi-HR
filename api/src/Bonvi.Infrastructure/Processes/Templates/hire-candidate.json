{
  "schema": 1,
  "code": "hire-candidate",
  "version": "1.0",
  "title": "Nomzod tanlovi",
  "source": "HR-R02",
  "subjectKind": "candidate",
  "board": [
    {"key": "contact", "title": "Bog'lanish"},
    {"key": "form", "title": "Anketa"},
    {"key": "council", "title": "Kengash"},
    {"key": "check", "title": "Surishtiruv"},
    {"key": "offer", "title": "Taklif"},
    {"key": "firstDay", "title": "Ishga chiqish"}
  ],
  "steps": [
    {
      "id": "r02-5",
      "title": "Nomzodga qo'ng'iroq qiling va ofisga taklif qiling",
      "column": "contact",
      "role": "hr4",
      "kind": "fact",
      "due": {"from": "candidate.appliedOn", "workingDays": 3},
      "completion": {"fact": "cand.contacted"},
      "manual": {
        "allowed": true,
        "inputs": [
          {
            "id": "result",
            "label": "Natija",
            "type": "choice",
            "required": true,
            "options": [
              {"value": "invited", "label": "Ofisga taklif qilindi"},
              {"value": "noAnswer", "label": "Javob bermadi"},
              {"value": "notSuitable", "label": "Mos emas"}
            ]
          }
        ]
      },
      "guide": [
        "Murojaat qilgan nomzod bilan telefonda qisqa suhbat qiling.",
        "Mos kelsa, uni faqat markaziy ofisga taklif qiling — zavodda anketa olinmaydi.",
        "Zavodga kelgan nomzod haqida tabelchi shu kuni xabar beradi; u bilan 3 ish kuni ichida bog'laning."
      ],
      "sourceRef": "HR-R02, 3-bo'lim, 5-qadam",
      "link": {"screen": "candidate"}
    },
    {
      "id": "r02-6",
      "title": "Anketa oling va dastlabki suhbat o'tkazing",
      "column": "form",
      "role": "hr4",
      "blank": "HR-F02",
      "signature": "D2",
      "kind": "fact",
      "prereqs": ["r02-5"],
      "due": {"from": "candidate.appliedOn", "workingDays": 3},
      "completion": {"fact": "cand.f02"},
      "guide": [
        "Nomzod ofisda planshetda anketaning A qismini o'zi to'ldiradi va oxirida imzo qo'yadi.",
        "Planshet anketasidagi «Rasmga olish» bilan nomzodni rasmga oling — shu rasm xodim kartasiga va davomat terminaliga o'tadi.",
        "Hujjatlar rasmini oling (12-bo'lim), dastlabki suhbat o'tkazib 14-bo'limda baho va qaror qo'ying."
      ],
      "sourceRef": "HR-R02, 3-bo'lim, 6-qadam",
      "link": {"screen": "candidateForm"}
    },
    {
      "id": "r02-7",
      "title": "Amaliy sinovni tashkil qiling (ishchi kasblar)",
      "column": "form",
      "role": "hr4",
      "blank": "HR-F02",
      "signature": "D1",
      "kind": "fact",
      "prereqs": ["r02-6"],
      "optional": true,
      "due": {"from": "step:r02-6.doneOn", "workingDays": 2},
      "completion": {"fact": "cand.stage:practicalTest"},
      "manual": {
        "allowed": true,
        "inputs": [
          {"id": "score", "label": "Usta bahosi (1–5)", "type": "int", "required": true, "min": 1, "max": 5},
          {"id": "comment", "label": "Izoh", "type": "text"}
        ]
      },
      "skippable": true,
      "guide": [
        "Ishchi kasblar uchun amaliy sinov zavodda o'tadi: yo'llanma platformadan ustaga boradi.",
        "Usta bergan 1–5 bahoni va izohni shu qadamda «Bajarildi» bilan yozing."
      ],
      "sourceRef": "HR-R02, 3-bo'lim, 7-qadam",
      "link": {"screen": "candidate"}
    },
    {
      "id": "r02-9",
      "title": "Nomzodni Kengashga tayyorlang (HR-F04 ro'yxatiga kiriting)",
      "column": "council",
      "role": "hr4",
      "blank": "HR-F04",
      "kind": "fact",
      "prereqs": ["r02-6"],
      "due": {"rule": "nextCouncilDay", "from": "step:r02-6.doneOn"},
      "completion": {"fact": "cand.inF04", "args": {"legacyAnyOf": ["cand.stage:invited"]}},
      "manual": {"allowed": true, "inputs": []},
      "guide": [
        "Har nomzod bo'yicha hujjatlar to'plamini yig'ing: F01 va F02 (baho bilan). Surishtiruv Kengashdan keyin bo'ladi.",
        "Ish haqi taklifini tayyorlang va nomzodni HR-F04 bayonnomasi ro'yxatiga kiriting.",
        "Kengash haftada 1 marta (payshanba) bo'ladi."
      ],
      "sourceRef": "HR-R02, 3-bo'lim, 9-qadam",
      "link": {"screen": "blank", "args": {"template": "HR-F04"}}
    },
    {
      "id": "r02-10",
      "title": "Kengash qaror qabul qiladi",
      "column": "council",
      "role": "council",
      "fallbackRole": "hr1",
      "blank": "HR-F04",
      "signature": "D1",
      "kind": "fact",
      "prereqs": ["r02-9"],
      "due": {"rule": "nextCouncilDay", "from": "step:r02-6.doneOn"},
      "completion": {"fact": "cand.f04Decision", "args": {"legacyAnyOf": ["cand.stage:council"], "manualValue": "decision"}},
      "manual": {
        "allowed": true,
        "inputs": [
          {
            "id": "decision",
            "label": "Kengash qarori",
            "type": "choice",
            "required": true,
            "options": [
              {"value": "accept", "label": "Qabul"},
              {"value": "conditional", "label": "Shartli qabul — surishtiruvdan keyin"},
              {"value": "reserve", "label": "Zaxira"},
              {"value": "reject", "label": "Rad"}
            ]
          },
          {"id": "councilDate", "label": "Kengash sanasi", "type": "date", "required": true}
        ]
      },
      "guide": [
        "Kengash har nomzod bo'yicha qaror qabul qiladi: qabul / zaxira / rad, va alohida shartlarni belgilaydi.",
        "Moddiy javobgar va rahbar lavozimlar uchun qaror «shartli qabul — surishtiruvdan keyin» bo'ladi.",
        "Kvorum — tasdiqlangan tarkibning kamida 2/3 qismi; rahbar lavozimlarni HR-1 shaxsan olib boradi.",
        "Bayonnomani rais va kotib (HR-1) imzolaydi. Kengashdan keyin nomzod kartasida «Кенгаш» bosqichini ham belgilang."
      ],
      "sourceRef": "HR-R02, 3-bo'lim, 10-qadam",
      "link": {"screen": "blank", "args": {"template": "HR-F04"}}
    },
    {
      "id": "r02-8",
      "title": "Surishtiruv o'tkazing (Kengashdan keyin, rozilik bilan)",
      "column": "check",
      "role": "hr4",
      "blank": "HR-F03",
      "signature": "D1",
      "kind": "fact",
      "prereqs": ["r02-10"],
      "when": {"fact": "cand.f04Decision", "equals": "conditional"},
      "due": {"from": "step:r02-10.doneOn", "workingDays": 3},
      "completion": {"fact": "cand.f03", "args": {"manualValue": "outcome"}},
      "manual": {
        "allowed": true,
        "inputs": [
          {
            "id": "outcome",
            "label": "Surishtiruv natijasi",
            "type": "choice",
            "required": true,
            "options": [
              {"value": "ok", "label": "Ishga olish mumkin — e'tiroz yo'q"},
              {"value": "watch", "label": "Ishga olish mumkin — kuzatuv bilan"},
              {"value": "notRecommended", "label": "Ishga olish tavsiya etilmaydi"}
            ]
          }
        ]
      },
      "guide": [
        "Surishtiruv faqat Kengash nomzodni «shartli qabul» qilganidan keyin o'tkaziladi.",
        "Faqat moddiy javobgar (omborchi, kassir, sotuvchi, haydovchi-ekspeditor...) va rahbar lavozimlar uchun; boshqalar uchun bu qadam o'tkazib yuboriladi.",
        "Nomzodning yozma roziligini oling (HR-F03), so'ng surishtiruvni o'tkazib natijani yozing: o'tdi / o'tmadi.",
        "«O'tmadi» bo'lsa — taklif berilmaydi, natija HR-1 ga yuboriladi."
      ],
      "sourceRef": "HR-R02, 3-bo'lim (egasi qarori 01-noyabr: surishtiruv Kengashdan keyin)",
      "link": {"screen": "blank", "args": {"template": "HR-F03", "subject": "candidate"}}
    },
    {
      "id": "r02-11",
      "title": "Natijani nomzodga yetkazing va taklif bering (HR-F05)",
      "column": "offer",
      "role": "hr4",
      "blank": "HR-F05",
      "signature": "D2",
      "kind": "fact",
      "prereqs": ["r02-10", "r02-8"],
      "due": {"from": "step:r02-8.doneOn", "workingDays": 1, "fallback": {"from": "step:r02-10.doneOn", "workingDays": 1}},
      "completion": {
        "fact": "cand.offerBranch",
        "args": {
          "byValue": {
            "accept": {"fact": "cand.f05Step:offerCandidate"},
            "decline": {"fact": "cand.status", "args": {"in": [2, 5]}}
          }
        }
      },
      "manual": {
        "allowed": true,
        "inputs": [
          {
            "id": "startDate",
            "label": "Ishga chiqish sanasi",
            "type": "date",
            "requiredWhen": {"fact": "cand.offerBranch", "equals": "accept"}
          }
        ]
      },
      "guide": [
        "Kengash natijasini har nomzodga yetkazing; zaxiraga olinganlarni zaxira bazaga kiriting.",
        "Qabul qilinganga HR-F05 ning 1-qismi (taklif) va 2-qismi (hujjatlar ro'yxati)ni bering.",
        "Nomzodga F05 da yozilganidan farqli ish haqi yoki sharoit va'da qilmang.",
        "Rad etilgan yoki zaxiraga olingan nomzodning holatini nomzod kartasida o'zgartiring — jarayon shundan keyin yopiladi."
      ],
      "sourceRef": "HR-R02, 3-bo'lim, 11-qadam",
      "link": {"screen": "blank", "args": {"template": "HR-F05", "subject": "candidate"}}
    },
    {
      "id": "r02-12",
      "title": "Hujjatlarni HR-2 ga topshiring",
      "column": "offer",
      "role": "hr4",
      "blank": "HR-F05",
      "signature": "D1",
      "kind": "fact",
      "prereqs": ["r02-11"],
      "when": {"fact": "cand.offerBranch", "equals": "accept"},
      "due": {"from": "f05.startDate", "days": -1, "fallback": {"from": "step:r02-11.doneOn", "workingDays": 3}},
      "completion": {"fact": "cand.f05Step:docsHandover"},
      "manual": {"allowed": true, "inputs": []},
      "guide": [
        "Kengash bayonnomasi (F04) va nomzod hujjatlarini (F05 bo'yicha) HR-2 ga topshiring.",
        "Keyingi rasmiylashtirishni HR-2 HR-R01, 2.1 bo'yicha bajaradi."
      ],
      "sourceRef": "HR-R02, 3-bo'lim, 12-qadam",
      "link": {"screen": "blank", "args": {"template": "HR-F05", "subject": "candidate"}}
    },
    {
      "id": "r02-13",
      "title": "Yangi xodimni kutib oling va HR-F11 da imzo oling",
      "column": "firstDay",
      "role": "hr4",
      "blank": "HR-F11",
      "signature": "D2",
      "kind": "fact",
      "prereqs": ["r02-12"],
      "when": {"fact": "cand.offerBranch", "equals": "accept"},
      "due": {"from": "employment.hireDate", "days": 0, "fallback": {"from": "f05.startDate", "days": 0}},
      "gate": [{"code": "Q01", "mode": "block"}, {"code": "Q04", "mode": "block"}],
      "completion": {"fact": "emp.f11"},
      "manual": {"allowed": true, "inputs": []},
      "guide": [
        "Yangi xodimni kutib oling va lavozim pasporti bilan tanishtirib, HR-F11 da imzo oling.",
        "Ustoz biriktiring va moslashtirish rejasini (HR-F06) bering (HR-R03).",
        "Anketa, Kengash qarori, buyruq va mehnat muhofazasi yo'riqnomasi bo'lmasa xodim ishga chiqarilmaydi."
      ],
      "sourceRef": "HR-R02, 3-bo'lim, 13-qadam",
      "link": {"screen": "blank", "args": {"template": "HR-F11", "subject": "employee"}}
    }
  ]
}

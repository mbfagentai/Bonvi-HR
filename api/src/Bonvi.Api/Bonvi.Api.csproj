<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ═══════════════════════════════════════════════════════════
     API QATLAMI — kompozitsiya ildizi (composition root)
     HTTP endpoint, autentifikatsiya, DI ro'yxatga olish.
     QOIDA: EF Core entity'si bu yerga chiqmaydi — faqat DTO.
    ═══════════════════════════════════════════════════════════
  -->

  <PropertyGroup>
    <RootNamespace>Bonvi.Api</RootNamespace>
    <UserSecretsId>bonvi-hr-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bonvi.Application\Bonvi.Application.csproj" />
    <ProjectReference Include="..\Bonvi.Infrastructure\Bonvi.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Hangfire.AspNetCore" />
  </ItemGroup>

</Project>

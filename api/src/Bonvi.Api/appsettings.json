{
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "bonvi-hr",
    "Audience": "bonvi-hr-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Bootstrap": {
    "AdminLogin": "",
    "AdminPassword": "",
    "AdminFullName": "Bosh administrator",
    "AutoMigrate": false,
    "CreateDevUsers": false
  },
  "Storage": {
    "RootPath": "/data/uploads",
    "MaxFileSizeBytes": 26214400
  },
  "Cors": {
    "Origins": [
      "http://localhost:7173"
    ]
  },
  "Security": {
    "MaxRequestBodyBytes": 31457280,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "Headers": {
      "EnableHsts": true,
      "HstsMaxAgeDays": 365,
      "HstsIncludeSubDomains": true,
      "HstsPreload": false,
      "NoStoreForApi": true,
      "ApiPathPrefix": "/api"
    }
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Api": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Export": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Performance": {
    "RequestTimeoutSeconds": 30,
    "LongRequestTimeoutSeconds": 180,
    "ReferenceCacheSeconds": 300,
    "CompressResponses": true,
    "CompressOverHttps": true,
    "Kestrel": {
      "MaxConcurrentConnections": 500,
      "MaxConcurrentUpgradedConnections": 100,
      "MinRequestBodyDataRateBytesPerSecond": 240,
      "MinDataRateGracePeriodSeconds": 10,
      "KeepAliveTimeoutSeconds": 120,
      "RequestHeadersTimeoutSeconds": 20,
      "MaxRequestHeadersTotalSizeBytes": 32768
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

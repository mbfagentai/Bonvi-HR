<Project Sdk="Microsoft.NET.Sdk">
  <!-- Use-case testi. Repository o'rniga NSubstitute mock. -->
  <PropertyGroup>
    <RootNamespace>Bonvi.Application.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bonvi.Application\Bonvi.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shart va computed vektorlari — veb (TS) testi ham shu faylni o'qiydi (SPEC-blankalar §4.5) -->
    <None Include="Blanks\computed-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 1-to'lqin shablonlari (Infrastructure'da embedded) — har biri tekshiruvdan o'tishi shart (SPEC-blankalar §14 S3) -->
    <None Include="..\..\src\Bonvi.Infrastructure\Blanks\Templates\*.json" Link="Blanks\Templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Process templates (Infrastructure, embedded) — each must pass the validator (SPEC-mening-ishlarim §3.1) -->
    <None Include="..\..\src\Bonvi.Infrastructure\Processes\Templates\*.json" Link="Processes\Templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

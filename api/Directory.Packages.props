<Project>

  <!--
    Markazlashgan paket boshqaruvi (Central Package Management).
    Versiya FAQAT shu yerda yoziladi — .csproj fayllarida versiya bo'lmaydi.
    Natija: butun yechimda bitta paketning ikki xil versiyasi bo'lishi mumkin emas.

    Oxirgi tekshiruv: 2026-08-22
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Ma'lumotlar bazasi">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.1" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <!--
      Telegram boti uchun (`Bonvi.Bot`). `Microsoft.NET.Sdk.Worker` ularni
      odatda O'ZI qo'shadi, lekin markazlashgan versiya boshqaruvida
      (`ManagePackageVersionsCentrally`) yashirin havolalar versiyasiz
      qolib, yig'ilish yiqiladi — shu sababli ochiq e'lon qilingan.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Validatsiya va mapping">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

  <!--
    Log.

    `Serilog.Sinks.File` — xato jurnali faylga yoziladi (Sentry o'rniga).
    Sentry ataylab RAD ETILDI: u tashqi xizmat, hisob va DSN talab qiladi va
    istisno tafsilotini konteynerdan tashqariga chiqaradi — bazada esa
    haqiqiy odamlarning JSHSHIR, pasport va oyligi bor.

    Litsenziya — Apache-2.0 (SkiaSharp/ImageSharp tanlovidagi bilan bir xil
    tekshiruv). Ustiga bu paket YANGI bog'liqlik ham emas: u
    `Serilog.AspNetCore` bilan birga allaqachon yuklab olinardi, endi esa
    to'g'ridan-to'g'ri ishlatilgani uchun oshkora yozib qo'yildi (markazlashgan
    boshqaruvda to'g'ridan-to'g'ri havolaning versiyasi shu yerda turishi shart).
  -->
  <ItemGroup Label="Log">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Fon vazifalar">
    <PackageVersion Include="Hangfire.Core" Version="1.8.24" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
  </ItemGroup>

  <!--
    Rasm qayta ishlash — xodim suratini kvadrat qilib kichraytirish uchun.

    SkiaSharp tanlandi, ImageSharp EMAS. Sabab LITSENZIYA: ImageSharp
    «Six Labors Split License» ostida va tijorat tashkilotidan (daromad
    chegarasidan yuqori) pullik litsenziya talab qiladi. Bonvi — ishlab
    chiqarish holdingi, ya'ni bu haqiqiy xavf. SkiaSharp esa MIT.

    `NativeAssets.Linux.NoDependencies` — konteyner uchun: u fontconfig va
    boshqa tizim kutubxonalarini talab qilmaydi. Bizga faqat rasmni ochish,
    kichraytirish va saqlash kerak, matn chizish kerak emas.
  -->
  <ItemGroup Label="Rasm">
    <PackageVersion Include="SkiaSharp" Version="3.119.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup Label="Excel">
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup Label="Testlar">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

</Project>

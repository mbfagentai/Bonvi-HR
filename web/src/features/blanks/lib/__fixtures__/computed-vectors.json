{
  "about": [
    "Shared vectors for blank conditions (SPEC-blankalar 4.4) and computed expressions (4.5).",
    "Both the C# evaluator (BlankComputedVectorsTests) and the web TS evaluator must pass every case.",
    "Evaluation is type-agnostic: a choice object yields its 'value', a ref object its 'id', a multi array is a list.",
    "Numbers compare with tolerance 1e-9. Dates are 'yyyy-MM-dd' strings. Working days = Monday-Friday, no holidays.",
    "round = half away from zero. Aggregates skip null/non-numbers; avg/min/max of nothing = null; sum/count of nothing = 0.",
    "Any other op with a null (or wrongly typed) input returns null; division by zero returns null.",
    "Table columns are addressed as 'table[*].col' and yield the column values of every row."
  ],
  "conditions": [
    { "name": "eq on choice compares .value", "answers": { "d": { "value": "stop", "extra": "x" } }, "when": { "field": "d", "eq": "stop" }, "expected": true },
    { "name": "eq on choice mismatch", "answers": { "d": { "value": "continue" } }, "when": { "field": "d", "eq": "stop" }, "expected": false },
    { "name": "eq on plain string", "answers": { "initiative": "employee" }, "when": { "field": "initiative", "eq": "employee" }, "expected": true },
    { "name": "eq number ignores scale", "answers": { "n": 1.0 }, "when": { "field": "n", "eq": 1 }, "expected": true },
    { "name": "eq bool", "answers": { "agree": false }, "when": { "field": "agree", "eq": false }, "expected": true },
    { "name": "eq string vs number is false", "answers": { "n": "1" }, "when": { "field": "n", "eq": 1 }, "expected": false },
    { "name": "eq on missing field is false", "answers": {}, "when": { "field": "x", "eq": "a" }, "expected": false },
    { "name": "eq on ref compares id", "answers": { "m": { "id": "0199f0a0-5e1d-7c00-8000-000000000001", "label": "Ali" } }, "when": { "field": "m", "eq": "0199f0a0-5e1d-7c00-8000-000000000001" }, "expected": true },
    { "name": "in matches one of", "answers": { "t": { "value": "b" } }, "when": { "field": "t", "in": ["a", "b"] }, "expected": true },
    { "name": "in no match", "answers": { "t": { "value": "c" } }, "when": { "field": "t", "in": ["a", "b"] }, "expected": false },
    { "name": "eq on multi: any selected", "answers": { "v": [{ "value": "late" }, { "value": "absent" }] }, "when": { "field": "v", "eq": "absent" }, "expected": true },
    { "name": "in on multi: any selected in list", "answers": { "v": [{ "value": "late" }] }, "when": { "field": "v", "in": ["absent", "late"] }, "expected": true },
    { "name": "eq on empty multi is false", "answers": { "v": [] }, "when": { "field": "v", "eq": "late" }, "expected": false },
    { "name": "filled: text", "answers": { "e": "Tushuntirish" }, "when": { "field": "e", "filled": true }, "expected": true },
    { "name": "filled: whitespace is empty", "answers": { "e": "   " }, "when": { "field": "e", "filled": true }, "expected": false },
    { "name": "filled: empty array is empty", "answers": { "f": [] }, "when": { "field": "f", "filled": true }, "expected": false },
    { "name": "filled: empty object is empty", "answers": { "r": {} }, "when": { "field": "r", "filled": true }, "expected": false },
    { "name": "filled: false bool is filled", "answers": { "b": false }, "when": { "field": "b", "filled": true }, "expected": true },
    { "name": "filled: 0 is filled", "answers": { "n": 0 }, "when": { "field": "n", "filled": true }, "expected": true },
    { "name": "filled false on missing", "answers": {}, "when": { "field": "explanation", "filled": false }, "expected": true },
    { "name": "all", "answers": { "a": "x", "b": 2 }, "when": { "all": [{ "field": "a", "eq": "x" }, { "field": "b", "in": [1, 2] }] }, "expected": true },
    { "name": "all with one false", "answers": { "a": "x", "b": 3 }, "when": { "all": [{ "field": "a", "eq": "x" }, { "field": "b", "in": [1, 2] }] }, "expected": false },
    { "name": "any", "answers": { "a": "y", "b": 2 }, "when": { "any": [{ "field": "a", "eq": "x" }, { "field": "b", "eq": 2 }] }, "expected": true },
    { "name": "not", "answers": { "a": "y" }, "when": { "not": { "field": "a", "eq": "x" } }, "expected": true },
    { "name": "nested", "answers": { "a": "x", "c": "" }, "when": { "all": [{ "field": "a", "eq": "x" }, { "not": { "field": "c", "filled": true } }] }, "expected": true }
  ],
  "computed": [
    { "name": "avg of table column skips empty", "answers": { "c": [{ "score": 4 }, { "score": 3 }, { "score": 5 }, { "score": null }, {}] }, "expr": { "op": "avg", "args": [{ "ref": "c[*].score" }] }, "expected": 4 },
    { "name": "avg of nothing is null", "answers": { "c": [] }, "expr": { "op": "avg", "args": [{ "ref": "c[*].score" }] }, "expected": null },
    { "name": "avg of missing table is null", "answers": {}, "expr": { "op": "avg", "args": [{ "ref": "c[*].score" }] }, "expected": null },
    { "name": "round avg to 2 decimals", "answers": { "c": [{ "score": 4 }, { "score": 3 }, { "score": 4 }] }, "expr": { "op": "round", "args": [{ "op": "avg", "args": [{ "ref": "c[*].score" }] }, { "const": 2 }] }, "expected": 3.67 },
    { "name": "round half away from zero", "answers": {}, "expr": { "op": "round", "args": [{ "const": 2.345 }, { "const": 2 }] }, "expected": 2.35 },
    { "name": "avg of scalar refs", "answers": { "a": 2, "b": 3 }, "expr": { "op": "avg", "args": [{ "ref": "a" }, { "ref": "b" }, { "ref": "missing" }] }, "expected": 2.5 },
    { "name": "sum of weights", "answers": { "k": [{ "w": 40 }, { "w": 35 }, { "w": 25 }] }, "expr": { "op": "sum", "args": [{ "ref": "k[*].w" }] }, "expected": 100 },
    { "name": "weights equal 100", "answers": { "k": [{ "w": 40 }, { "w": 35 }, { "w": 25 }] }, "expr": { "op": "eq", "args": [{ "op": "sum", "args": [{ "ref": "k[*].w" }] }, { "const": 100 }] }, "expected": true },
    { "name": "weights not 100", "answers": { "k": [{ "w": 40 }, { "w": 35 }] }, "expr": { "op": "eq", "args": [{ "op": "sum", "args": [{ "ref": "k[*].w" }] }, { "const": 100 }] }, "expected": false },
    { "name": "sum of nothing is 0", "answers": {}, "expr": { "op": "sum", "args": [{ "ref": "k[*].w" }] }, "expected": 0 },
    { "name": "count non-empty", "answers": { "t": [{ "x": "a" }, { "x": null }, { "x": "b" }, { "x": "" }] }, "expr": { "op": "count", "args": [{ "ref": "t[*].x" }] }, "expected": 2 },
    { "name": "min", "answers": { "t": [{ "x": 5 }, { "x": 2 }, { "x": 9 }] }, "expr": { "op": "min", "args": [{ "ref": "t[*].x" }] }, "expected": 2 },
    { "name": "max", "answers": { "t": [{ "x": 5 }, { "x": 2 }, { "x": 9 }] }, "expr": { "op": "max", "args": [{ "ref": "t[*].x" }, { "const": 7 }] }, "expected": 9 },
    { "name": "sub", "answers": { "start": 10, "left": 4 }, "expr": { "op": "sub", "args": [{ "ref": "start" }, { "ref": "left" }] }, "expected": 6 },
    { "name": "add", "answers": {}, "expr": { "op": "add", "args": [{ "const": 0.1 }, { "const": 0.2 }] }, "expected": 0.3 },
    { "name": "mul", "answers": {}, "expr": { "op": "mul", "args": [{ "const": 1.5 }, { "const": 4 }] }, "expected": 6 },
    { "name": "div", "answers": {}, "expr": { "op": "div", "args": [{ "const": 1 }, { "const": 4 }] }, "expected": 0.25 },
    { "name": "div by zero is null", "answers": {}, "expr": { "op": "div", "args": [{ "const": 1 }, { "const": 0 }] }, "expected": null },
    { "name": "null input gives null", "answers": {}, "expr": { "op": "add", "args": [{ "ref": "missing" }, { "const": 1 }] }, "expected": null },
    { "name": "text input to number op gives null", "answers": { "a": "x" }, "expr": { "op": "add", "args": [{ "ref": "a" }, { "const": 1 }] }, "expected": null },
    { "name": "addDays", "answers": { "hireDate": "2026-11-03" }, "expr": { "op": "addDays", "args": [{ "ref": "hireDate" }, { "const": 7 }] }, "expected": "2026-11-10" },
    { "name": "addDays negative across year", "answers": { "d": "2026-01-02" }, "expr": { "op": "addDays", "args": [{ "ref": "d" }, { "const": -5 }] }, "expected": "2025-12-28" },
    { "name": "addDays +90 probation end", "answers": { "hireDate": "2026-11-03" }, "expr": { "op": "addDays", "args": [{ "ref": "hireDate" }, { "const": 90 }] }, "expected": "2027-02-01" },
    { "name": "addDays non-integer is null", "answers": { "d": "2026-01-02" }, "expr": { "op": "addDays", "args": [{ "ref": "d" }, { "const": 1.5 }] }, "expected": null },
    { "name": "addDays on bad date is null", "answers": { "d": "02.01.2026" }, "expr": { "op": "addDays", "args": [{ "ref": "d" }, { "const": 1 }] }, "expected": null },
    { "name": "diffDays staj", "answers": { "hired": "2026-01-15", "left": "2026-03-01" }, "expr": { "op": "diffDays", "args": [{ "ref": "hired" }, { "ref": "left" }] }, "expected": 45 },
    { "name": "diffDays negative", "answers": {}, "expr": { "op": "diffDays", "args": [{ "const": "2026-03-01" }, { "const": "2026-02-27" }] }, "expected": -2 },
    { "name": "diffDays takes date part of datetime", "answers": {}, "expr": { "op": "diffDays", "args": [{ "const": "2026-03-01T23:00:00+05:00" }, { "const": "2026-03-02" }] }, "expected": 1 },
    { "name": "addMonths clamps to month end", "answers": {}, "expr": { "op": "addMonths", "args": [{ "const": "2026-01-31" }, { "const": 1 }] }, "expected": "2026-02-28" },
    { "name": "addMonths 3 (probation)", "answers": {}, "expr": { "op": "addMonths", "args": [{ "const": "2026-05-10" }, { "const": 3 }] }, "expected": "2026-08-10" },
    { "name": "addWorkingDays over weekend", "answers": {}, "expr": { "op": "addWorkingDays", "args": [{ "const": "2026-11-06" }, { "const": 1 }] }, "expected": "2026-11-09" },
    { "name": "addWorkingDays backwards", "answers": {}, "expr": { "op": "addWorkingDays", "args": [{ "const": "2026-11-09" }, { "const": -3 }] }, "expected": "2026-11-04" },
    { "name": "addWorkingDays zero keeps date", "answers": {}, "expr": { "op": "addWorkingDays", "args": [{ "const": "2026-11-07" }, { "const": 0 }] }, "expected": "2026-11-07" },
    { "name": "diffWorkingDays", "answers": {}, "expr": { "op": "diffWorkingDays", "args": [{ "const": "2026-11-06" }, { "const": "2026-11-16" }] }, "expected": 6 },
    { "name": "diffWorkingDays reversed", "answers": {}, "expr": { "op": "diffWorkingDays", "args": [{ "const": "2026-11-16" }, { "const": "2026-11-06" }] }, "expected": -6 },
    { "name": "gte pass at 70", "answers": { "p": 72.5 }, "expr": { "op": "gte", "args": [{ "ref": "p" }, { "const": 70 }] }, "expected": true },
    { "name": "gte exactly", "answers": { "p": 70 }, "expr": { "op": "gte", "args": [{ "ref": "p" }, { "const": 70 }] }, "expected": true },
    { "name": "lt", "answers": { "p": 69.9 }, "expr": { "op": "lt", "args": [{ "ref": "p" }, { "const": 70 }] }, "expected": true },
    { "name": "gt and lte", "answers": {}, "expr": { "op": "and", "args": [{ "op": "gt", "args": [{ "const": 2 }, { "const": 1 }] }, { "op": "lte", "args": [{ "const": 1 }, { "const": 1 }] }] }, "expected": true },
    { "name": "compare with null is null", "answers": {}, "expr": { "op": "gte", "args": [{ "ref": "p" }, { "const": 70 }] }, "expected": null },
    { "name": "compare dates", "answers": {}, "expr": { "op": "lt", "args": [{ "const": "2026-01-02" }, { "const": "2026-01-10" }] }, "expected": true },
    { "name": "eq on choice ref", "answers": { "d": { "value": "stop" } }, "expr": { "op": "eq", "args": [{ "ref": "d" }, { "const": "stop" }] }, "expected": true },
    { "name": "or", "answers": {}, "expr": { "op": "or", "args": [{ "const": false }, { "const": true }] }, "expected": true },
    { "name": "and with null is null", "answers": {}, "expr": { "op": "and", "args": [{ "const": true }, { "ref": "x" }] }, "expected": null },
    { "name": "not", "answers": {}, "expr": { "op": "not", "args": [{ "const": false }] }, "expected": true },
    { "name": "if true branch", "answers": { "p": 80 }, "expr": { "op": "if", "args": [{ "op": "gte", "args": [{ "ref": "p" }, { "const": 70 }] }, { "const": "ha" }, { "const": "yo'q" }] }, "expected": "ha" },
    { "name": "if false branch", "answers": { "p": 50 }, "expr": { "op": "if", "args": [{ "op": "gte", "args": [{ "ref": "p" }, { "const": 70 }] }, { "const": "ha" }, { "const": "yo'q" }] }, "expected": "yo'q" },
    { "name": "if null condition is null", "answers": {}, "expr": { "op": "if", "args": [{ "ref": "c" }, { "const": 1 }, { "const": 2 }] }, "expected": null },
    { "name": "band high", "answers": { "avg": 3.6 }, "expr": { "op": "band", "value": { "ref": "avg" }, "bands": [{ "from": 3.5, "label": "o'tdi" }, { "from": 3.0, "label": "shartli" }, { "from": null, "label": "o'tmadi" }] }, "expected": "o'tdi" },
    { "name": "band boundary", "answers": { "avg": 3.5 }, "expr": { "op": "band", "value": { "ref": "avg" }, "bands": [{ "from": 3.5, "label": "o'tdi" }, { "from": 3.0, "label": "shartli" }, { "from": null, "label": "o'tmadi" }] }, "expected": "o'tdi" },
    { "name": "band middle", "answers": { "avg": 3.2 }, "expr": { "op": "band", "value": { "ref": "avg" }, "bands": [{ "from": 3.5, "label": "o'tdi" }, { "from": 3.0, "label": "shartli" }, { "from": null, "label": "o'tmadi" }] }, "expected": "shartli" },
    { "name": "band low", "answers": { "avg": 2.9 }, "expr": { "op": "band", "value": { "ref": "avg" }, "bands": [{ "from": 3.5, "label": "o'tdi" }, { "from": 3.0, "label": "shartli" }, { "from": null, "label": "o'tmadi" }] }, "expected": "o'tmadi" },
    { "name": "band of null is null", "answers": {}, "expr": { "op": "band", "value": { "ref": "avg" }, "bands": [{ "from": 3.5, "label": "o'tdi" }, { "from": null, "label": "o'tmadi" }] }, "expected": null },
    { "name": "band without catch-all below lowest is null", "answers": { "avg": 1 }, "expr": { "op": "band", "value": { "ref": "avg" }, "bands": [{ "from": 3.5, "label": "o'tdi" }] }, "expected": null }
  ]
}
